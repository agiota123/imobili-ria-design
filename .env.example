# Public configuration for this company's dedicated Supabase project.
# This publishable key is safe to expose only when database RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server runtime values, configured separately in Vercel.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never expose SUPABASE_SERVICE_ROLE_KEY in the frontend or any VITE_ variable.
# This template's browser data layer does not require a service-role key.
